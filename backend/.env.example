# Generate a real value with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DATABASE_URL=sqlite:///./myomr.db

# Local development frontend origins. For deployment, replace with your real domain,
# for example: https://your-domain.vercel.app
# Use * to allow all origins (useful for ngrok / Vercel demo deployments).
# Note: wildcard disables credentials (cookies), but JWT via Authorization header still works.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

MAX_UPLOAD_SIZE_MB=20
MAX_CONCURRENT_OMR_JOBS=1
PROCESSING_STALE_MINUTES=30

# Optional absolute paths for deployment.
# Keep these commented for local development unless you want runtime files outside backend/.
# UPLOADS_DIR=/var/www/myomr/uploads
# OUTPUTS_DIR=/var/www/myomr/outputs
# CHECKPOINTS_DIR=/var/www/myomr/checkpoints
# SKLEARN_MODELS_DIR=/var/www/myomr/sklearn_models
